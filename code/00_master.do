/*==============================================================================
 Project : Master's thesis - Populism in donor countries and bilateral ODA
 Author  : [Your name]
 File    : 00_master.do
 Purpose : Sets paths, installs packages (optional) and runs the full pipeline
           in the correct order.

 Folder structure (relative to $root):
     code/            all do-files
     data/raw/        original files (ODA csv files, GPD, vote shares, etc.)
     data/clean/      datasets generated by the code (.dta)
     output/tables/   LaTeX tables
     output/figures/  graphs (.png)
     output/est/      stored estimation results (.ster)
     logs/            log files

 HOW TO RUN: edit the single line "global root" below, then run this file.
==============================================================================*/

clear all
set more off
version 16          // adjust to your Stata version

*------------------------------------------------------------------------------
* 1. Paths  (the ONLY line you need to edit)
*------------------------------------------------------------------------------
global root    "C:/path/to/master-thesis-stata"

global code    "$root/code"
global raw     "$root/data/raw"
global clean   "$root/data/clean"
global tables  "$root/output/tables"
global figures "$root/output/figures"
global est     "$root/output/est"
global logs    "$root/logs"

foreach d in "$clean" "$tables" "$figures" "$est" "$logs" {
    capture mkdir "`d'"
}

*------------------------------------------------------------------------------
* 2. Packages (set to 1 on the first run only)
*------------------------------------------------------------------------------
local install_packages 0

if `install_packages' == 1 {
    foreach pkg in reghdfe ftools coefplot estout csdid drdid {
        ssc install `pkg', replace
    }
}

*------------------------------------------------------------------------------
* 3. Pipeline
*------------------------------------------------------------------------------
capture log close _all
log using "$logs/master.log", replace text

do "$code/01_clean.do"          // import, append and clean raw data
do "$code/02_construction.do"   // build variables and final analysis dataset
do "$code/03_analysis.do"       // descriptive statistics
do "$code/04_model.do"          // baseline event studies (global, sector, region)
do "$code/05_robustness.do"     // Callaway & Sant'Anna, threshold sensitivity

log close
